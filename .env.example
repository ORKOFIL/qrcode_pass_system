# Рядок підключення до PostgreSQL (збігається з docker-compose.yml)
DATABASE_URL="postgresql://username:password@127.0.0.1:5433/qrcode_pass_system?sslmode=disable"

# Секрети для підпису JWT. Згенеруй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_SECRET"

# Необов'язково
PORT=3000
FRONTEND_URL="http://localhost:5173"
